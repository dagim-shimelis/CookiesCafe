{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{public/**,css2/**,fonts2/**,images2/**,js2/**,webfonts/**,node_modules/**,tests/**,.git/**,.env*,**/*.log,**/*.sql,*.code-workspace,*.html,*.png}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
